# Python bytecode and development caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Local environments and machine-specific settings
.venv/
venv/
env/
envs/
.env
.env.*
!.env.example

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Generated training outputs (published archives remain in original-results/)
results/
exports/
logs/
checkpoints/
runs/
wandb/
lightning_logs/
*.log

# Model checkpoints and large model binaries
*.pt
*.pth
*.ckpt
*.safetensors

# Retain the deterministic Fashion-MNIST label-noise caches
!/rg-classification-fmnist/noise_cache/*.pt

# Downloaded datasets at the root of each experimental project.
# Explicit paths keep source code under core/data/ trackable.
/rg-classification-fmnist/data/*
!/rg-classification-fmnist/data/README.txt
!/rg-classification-fmnist/data/README.md

/rg-classification-cifar/data/*
!/rg-classification-cifar/data/README.txt
!/rg-classification-cifar/data/README.md

/rg-regression/data/*
!/rg-regression/data/README.txt
!/rg-regression/data/README.md

# Optional dataset directory at the repository root
/data/*
!/data/README.txt
!/data/README.md

# Generated release archives
*.zip
